{
  "name": "poszee-attendance",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:packages": "pnpm --filter @poszee/shared build && pnpm --filter @poszee/db build",
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm build:packages && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @poszee/db generate",
    "db:migrate": "pnpm --filter @poszee/db migrate",
    "db:seed": "pnpm --filter @poszee/db seed",
    "db:reset": "pnpm --filter @poszee/db reset"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
